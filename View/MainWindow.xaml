<Window
    x:Class="View.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:View.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:View.Model"
    xmlns:controls="clr-namespace:View.Controls"
    Title="Contacts"
    Width="525"
    Height="400"
    MinWidth="525"
    MinHeight="400"
    Padding="15"
    d:DataContext="{d:DesignInstance Type=model:Contact}"
    Icon="\Resources\ContactsApp_96x96.ico"
    mc:Ignorable="d">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>

        <!-- DataTemplate для списка контактов -->
        <DataTemplate x:Key="ContactTemplate">
            <StackPanel Margin="3">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="{Binding Name}"/>
                <TextBlock
                    FontSize="10"
                    Text="{Binding PhoneNumber}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель -->
        <Grid
            Grid.Column="0"
            Margin="8"
            Background="#f8f8f8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Поле поиска -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="0 0 5 0"
                    VerticalAlignment="Center"
                    Text="Find:"/>
                <TextBox
                    Grid.Column="1"
                    Margin="0 0 0 0"
                    VerticalAlignment="Center"/>
            </Grid>

            <!-- Список контактов с прокруткой -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ListBox
                    Margin="0 8 0 8"
                    ItemsSource="{Binding Contacts}"
                    SelectedItem="{Binding SelectedContact, Mode=TwoWay}"
                    ItemTemplate="{StaticResource ContactTemplate}"/>
            </ScrollViewer>

            <!-- Кнопки управления -->
            <Grid Grid.Row="2" Margin="3 3 0 3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="21*"/>
                    <RowDefinition Height="11*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Height="25"
                    Margin="3 3 3 3"
                    Command="{Binding AddCommand}"
                    Content="Add"
                    IsEnabled="{Binding IsApplyButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"/>
                <Button
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    Height="25"
                    Margin="3 3 3 3"
                    Command="{Binding EditCommand}"
                    Content="Edit"
                    IsEnabled="{Binding IsContactSelected}"/>
                <Button
                    Grid.RowSpan="2"
                    Grid.Column="2"
                    Height="25"
                    Margin="3 3 0 3"
                    Command="{Binding RemoveCommand}"
                    Content="Remove"
                    IsEnabled="{Binding IsContactSelected}"/>
            </Grid>
        </Grid>

        <!-- GridSplitter -->
        <GridSplitter
            Grid.Column="1"
            Width="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Background="Gray"/>

        <!-- Правая панель -->
        <controls:ContactControl
            Grid.Column="2"
            Margin="8"
            DataContext="{Binding SelectedContact}"/>
    </Grid>
</Window>