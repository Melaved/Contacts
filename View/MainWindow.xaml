<Window
    x:Class="View.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:View.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:View.ViewModel"
    Title="Contacts"
    Width="525"
    Height="375"
    Padding="15"
    d:DataContext="{d:DesignInstance Type=viewmodel:MainVM}"
    Icon="\Resources\ContactsApp_96x96.ico"
    mc:Ignorable="d">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!--  Левая панель  -->
        <Grid
            Grid.Column="0"
            Margin="8"
            Background="#f8f8f8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!--  Поле поиска  -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="0 0 5 0"
                    VerticalAlignment="Center"
                    Text="Find:"/>
                <TextBox
                    Grid.ColumnSpan="2"
                    Margin="30 0 0 0"
                    VerticalAlignment="Center"/>
            </Grid>

            <!--  Список контактов с прокруткой  -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ListView
                    Margin="0 8 0 8"
                    ItemsSource="{Binding Contacts}"
                    SelectedItem="{Binding SelectedContact, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="3" Text="{Binding Name}"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </ScrollViewer>

            <!--  Кнопки управления  -->
            <Grid Grid.Row="2" Margin="3 3 0 3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="21*"/>
                    <RowDefinition Height="11*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Height="25"
                    Margin="3 3 3 3"
                    Command="{Binding AddCommand}"
                    Content="Add"
                    IsEnabled="{Binding IsApplyButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"/>
                <Button
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    Height="25"
                    Margin="3 3 3 3"
                    Command="{Binding EditCommand}"
                    Content="Edit"
                    IsEnabled="{Binding IsContactSelected}"/>
                <Button
                    Grid.RowSpan="2"
                    Grid.Column="2"
                    Height="25"
                    Margin="3 3 0 3"
                    Command="{Binding RemoveCommand}"
                    Content="Remove"
                    IsEnabled="{Binding IsContactSelected}"/>
            </Grid>
        </Grid>

        <!--  GridSplitter  -->
        <GridSplitter
            Grid.Column="1"
            Width="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Background="Gray"/>

        <!--  Правая панель  -->
        <Grid Grid.Column="2" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--  Изображение  -->
            <Image
                Grid.Row="0"
                Grid.RowSpan="6"
                Grid.Column="0"
                Width="100"
                Height="100"
                Margin="0 20 8 0"
                VerticalAlignment="Top"
                Source="\Resources\photo_placeholder_100x100.png"/>

            <!--  Поля для ввода данных  -->
            <TextBlock
                Grid.Row="0"
                Grid.Column="1"
                VerticalAlignment="Center"
                Text="Name:"/>
            <TextBox
                Grid.Row="1"
                Grid.Column="1"
                Margin="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Text="{Binding SelectedContact.Name, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock
                Grid.Row="2"
                Grid.Column="1"
                VerticalAlignment="Center"
                Text="Phone Number:"/>
            <TextBox
                Grid.Row="3"
                Grid.Column="1"
                Margin="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Text="{Binding SelectedContact.PhoneNumber, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock
                Grid.Row="4"
                Grid.Column="1"
                VerticalAlignment="Center"
                Text="Email:"/>
            <TextBox
                Grid.Row="5"
                Grid.Column="1"
                Margin="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Text="{Binding SelectedContact.Email, UpdateSourceTrigger=PropertyChanged}"/>

            <!--  Кнопка Apply  -->
            <Button
                Grid.Row="6"
                Grid.Column="1"
                Width="75"
                Height="25"
                Margin="0 50 0 0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Command="{Binding ApplyCommand}"
                Content="Apply"
                Visibility="{Binding IsApplyButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</Window>